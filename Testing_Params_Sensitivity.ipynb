   ],
   "execution_count": 3
  },
  {
   "cell_type": "markdown",
   "id": "sim_header",
   "metadata": {},
   "source": [
    "## 4 · Perturbed Forward Passes\n",
    "\n",
    "> ⚠️ This cell runs **one simulation per parameter + 1 nominal** — it can take several minutes depending on `SIMULATION_RESOLUTION` and `NB_PERIODS`."
   ]
  },
  {
   "cell_type": "code",
   "id": "simulation",
   "metadata": {
    "ExecuteTime": {
     "start_time": "2026-04-15T12:10:56.432486500Z"
    }
   },
   "source": [
    "perturbed_F = quantum_network.forward_perturbed(X=X, gradient_estimator=gradient_estimator)\n",
    "\n",
    "nb_simulations, seq_len, feature_dim = perturbed_F.shape\n",
    "print(f\"perturbed_F shape : {perturbed_F.shape}\")\n",
    "print(f\"  ├─ {nb_simulations} simulations (1 nominal + {nb_simulations - 1} perturbed)\")\n",
    "print(f\"  ├─ {seq_len} time steps\")\n",
    "print(f\"  └─ {feature_dim} features (quadratures × measure_resolution)\")"
   ],
   "outputs": [
